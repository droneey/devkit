{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "attributePosition": "multiline",
    "expand": "always",
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "multiline"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              ":NODE:",
              ":BLANK_LINE:",
              ":BUN:",
              ":BLANK_LINE:",
              [
                "@nest*",
                "nest*"
              ],
              ":BLANK_LINE:",
              [
                "react",
                "react/**",
                "react-*"
              ],
              ":BLANK_LINE:",
              "@tanstack/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "noDuplicateClasses": {
          "level": "on",
          "options": {}
        },
        "useSortedInterfaceMembers": {
          "level": "on",
          "options": {}
        }
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // errors-surfaced-never-swallowed
        "noEmptyBlockStatements": "error",
        "noUnusedExpressions": "error",
        "useAwait": "error",
        // no-debug-output-in-shipped-code
        "noAlert": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        // no-debug-output-in-shipped-code
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        // no-any
        "noEvolvingTypes": "error",
        "noMisplacedAssertion": "error",
        // no-skipped-or-empty-tests
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noVar": "error",
        "noReturnAssign": "error",
        "noProto": "error",
        "noDuplicateEnumValues": "error",
        "noForIn": "error",
        "noNestedPromises": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        // strict-equality-only
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        },
        // no-any
        "noExplicitAny": "error",
        // no-skipped-or-empty-tests
        "noFocusedTests": "error",
        // no-debug-output-in-shipped-code
        "noDebugger": "error",
        // no-unchecked-escape-hatches
        "noTsIgnore": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "useThrowOnlyError": "error",
        "noParameterProperties": "error",
        "useNumberNamespace": "error",
        "noMagicNumbers": "error",
        "useBlockStatements": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "noNegationElse": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useShorthandAssign": "error",
        "noYodaExpression": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit"
          }
        },
        "useExplicitLengthCheck": "error",
        "useAtIndex": "error",
        "useTrimStartEnd": "error",
        "noSubstr": "error",
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noDoneCallback": "error",
        "noExportedImports": "error",
        "noNamespace": "error",
        // identifier-case-by-kind
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "typeParameter"
                },
                "match": "T([A-Z].*)?",
                "formats": [
                  "PascalCase"
                ]
              }
            ]
          }
        },
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useSingleVarDeclarator": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useUnifiedTypeSignatures": "error",
        "useNodeAssertStrict": "error",
        "useExportType": "error",
        "useExportsLast": "error",
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        // enums-for-named-value-groups
        "useEnumInitializers": "error",
        "useAsConstAssertion": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentTypeDefinitions": "error",
        "useTemplate": "error",
        "useArrayLiterals": "error",
        "useExponentiationOperator": "error",
        "noShoutyConstants": "error",
        "noUnusedTemplateLiteral": "error",
        // kebab-case-file-names
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": [
              "kebab-case"
            ]
          }
        },
        "noMultiAssign": "error",
        "noExcessiveClassesPerFile": "error",
        // function-file-and-complexity-limits
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500
          }
        },
        // enums-for-named-value-groups
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useErrorCause": "error",
        "useGlobalThis": "error",
        "noMultilineString": "error",
        "useSpreadOverApply": "error",
        // no-unchecked-escape-hatches
        "noNonNullAssertion": "error"
      },
      "a11y": {
        "noNoninteractiveElementInteractions": "error"
      },
      "complexity": {
        "noUselessConstructor": "error",
        "useFlatMap": "error",
        "noUselessRename": "error",
        "noUselessEmptyExport": "error",
        "noUselessSwitchCase": "error",
        "useLiteralKeys": "off",
        "noUselessTernary": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessLabel": "error",
        "noExtraBooleanCast": "error",
        "noVoid": "error",
        // undefined-is-the-only-absence
        "noUselessUndefined": "error",
        "noUselessStringConcat": "error",
        // function-file-and-complexity-limits
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        // function-file-and-complexity-limits
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100
          }
        },
        "noImplicitCoercions": "error",
        "noForEach": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        // named-arguments-past-the-first, options-object-for-named-arguments
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 1
          }
        },
        "noUselessReturn": "error",
        "noRedundantDefaultExport": "error",
        "useArrayFind": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredDependencies": "error",
        "useJsonImportAttributes": "error",
        "noUnusedInstantiation": "error"
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 60
          }
        }
      },
      "performance": {
        "noDelete": "error",
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noDynamicNamespaceImportAccess": "error",
        // surface-only-re-exports
        "noReExportAll": "error"
      },
      "nursery": {
        // async-work-awaited-or-deliberately-detached
        "noFloatingPromises": "error",
        "useExplicitType": "error",
        "noConditionalExpect": "error",
        // async-work-awaited-or-deliberately-detached
        "noMisusedPromises": "error",
        "useArraySome": "error",
        // async-work-awaited-or-deliberately-detached
        "useAwaitThenable": "error",
        // exhaustive-branching-over-unions
        "useExhaustiveSwitchCases": "error",
        // no-skipped-or-empty-tests
        "useExpect": "error",
        // nullish-operators-for-absence
        "useNullishCoalescing": "error",
        "useStringStartsEndsWith": "error",
        "useRegexpTest": "error",
        "noUselessTypeConversion": "error",
        "noEmptyObjectKeys": "error",
        "useDisposables": "error",
        "noLoopFunc": "error",
        "noNegationInEqualityCheck": "error",
        "noThisOutsideOfClass": "error",
        "useIncludes": "error",
        "useModernMathApis": "error",
        "useFlatMathMinMax": "error",
        "noTailwindArbitraryValue": "error",
        "noInvalidFileInputAccept": "error",
        "useControlLabel": "error",
        "noUndeclaredClasses": "error",
        "noUnusedClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noInvalidPropertyInitValue": "error",
        "useNamedLayer": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          },
          "nursery": {
            "useExplicitType": "off"
          },
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/bun.lock"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noEmptyObjectKeys": "off"
          }
        }
      }
    }
  ]
}
