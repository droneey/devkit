{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "formatter": {
    "lineWidth": 80,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "attributePosition": "multiline",
    "expand": "always",
    "useEditorconfig": true,
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "attributePosition": "multiline",
    },
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              ":NODE:",
              ":BLANK_LINE:",
              ":BUN:",
              ":BLANK_LINE:",
              [
                "@nest*",
                "nest*",
              ],
              ":BLANK_LINE:",
              [
                "react",
                "react/**",
                "react-*",
              ],
              ":BLANK_LINE:",
              "@tanstack/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:",
            ],
          },
        },
        "noDuplicateClasses": {
          "level": "on",
          "options": {},
        },
        "useSortedInterfaceMembers": {
          "level": "on",
          "options": {},
        },
      },
    },
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyBlockStatements": "error",
        "noUnusedExpressions": "error",
        "useAwait": "error",
        "noAlert": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "noConsole": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noEvolvingTypes": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noVar": "error",
        "noReturnAssign": "error",
        "noProto": "error",
        "noDuplicateEnumValues": "error",
        "noForIn": "error",
        "noNestedPromises": "error",
        "noShadow": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false,
          },
        },
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noDebugger": "error",
        "noTsIgnore": "error",
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType",
          },
        },
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "useThrowOnlyError": "error",
        "noParameterProperties": "error",
        "useNumberNamespace": "error",
        "noMagicNumbers": "error",
        "useBlockStatements": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "noNegationElse": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useShorthandAssign": "error",
        "noYodaExpression": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": {
            "accessibility": "explicit",
          },
        },
        "useExplicitLengthCheck": "error",
        "useAtIndex": "error",
        "useTrimStartEnd": "error",
        "noSubstr": "error",
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noDoneCallback": "error",
        "noExportedImports": "error",
        "noNamespace": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "typeParameter",
                },
                "match": "T([A-Z].*)?",
                "formats": [
                  "PascalCase",
                ],
              },
            ],
          },
        },
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useSingleVarDeclarator": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useUnifiedTypeSignatures": "error",
        "useNodeAssertStrict": "error",
        "useExportType": "error",
        "useExportsLast": "error",
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useEnumInitializers": "error",
        "useAsConstAssertion": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentTypeDefinitions": "error",
        "useTemplate": "error",
        "useArrayLiterals": "error",
        "useExponentiationOperator": "error",
        "noShoutyConstants": "error",
        "noUnusedTemplateLiteral": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": [
              "kebab-case",
            ],
          },
        },
        "noMultiAssign": "error",
        "noExcessiveClassesPerFile": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
          },
        },
        "useConsistentEnumValueType": "error",
        "useConsistentMethodSignatures": "error",
        "useErrorCause": "error",
        "useGlobalThis": "error",
        "noMultilineString": "error",
        "useSpreadOverApply": "error",
        "noNonNullAssertion": "error",
      },
      "a11y": {
        "noNoninteractiveElementInteractions": "error",
      },
      "complexity": {
        "noUselessConstructor": "error",
        "useFlatMap": "error",
        "noUselessRename": "error",
        "noUselessEmptyExport": "error",
        "noUselessSwitchCase": "error",
        "useLiteralKeys": "off",
        "noUselessTernary": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessLabel": "error",
        "noExtraBooleanCast": "error",
        "noVoid": "error",
        "noUselessUndefined": "error",
        "noUselessStringConcat": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10,
          },
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 100,
          },
        },
        "noImplicitCoercions": "error",
        "noForEach": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 1,
          },
        },
        "noUselessReturn": "error",
        "noRedundantDefaultExport": "error",
        "useArrayFind": "error",
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredDependencies": "error",
        "useJsonImportAttributes": "error",
        "noUnusedInstantiation": "error",
      },
      "security": {
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 60,
          },
        },
      },
      "performance": {
        "noDelete": "error",
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "error",
        "noDynamicNamespaceImportAccess": "error",
        "noReExportAll": "error",
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExplicitType": "error",
        "noConditionalExpect": "error",
        "noMisusedPromises": "error",
        "useArraySome": "error",
        "useAwaitThenable": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpect": "error",
        "useNullishCoalescing": "error",
        "useStringStartsEndsWith": "error",
        "useRegexpTest": "error",
        "noUselessTypeConversion": "error",
        "noEmptyObjectKeys": "error",
        "useDisposables": "error",
        "noLoopFunc": "error",
        "noNegationInEqualityCheck": "error",
        "noThisOutsideOfClass": "error",
        "useIncludes": "error",
        "useModernMathApis": "error",
        "useFlatMathMinMax": "error",
        "noTailwindArbitraryValue": "error",
        "noInvalidFileInputAccept": "error",
        "useControlLabel": "error",
        "noUndeclaredClasses": "error",
        "noUnusedClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noInvalidPropertyInitValue": "error",
        "useNamedLayer": "error",
      },
    },
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/.*rc.ts",
        "**/.*rc.js",
        "**/.*rc.mjs",
        "**/.*rc.cjs",
        "**/.dependency-cruiser.js",
        "**/.dependency-cruiser.mjs",
        "**/.dependency-cruiser.cjs",
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
          },
          "nursery": {
            "useExplicitType": "off",
          },
          "security": {
            "noSecrets": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.d.ts",
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
          },
          "style": {
            "noDefaultExport": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/bun.lock",
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noEmptyObjectKeys": "off",
          },
        },
      },
    },
    {
      "includes": [
        "**/*.jsonc",
      ],
      "json": {
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/no-null.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/surface.grit",
      "includes": [
        "**/index.ts",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/empty-names.grit",
      "includes": [
        "**",
        "!**/src/libs/**",
      ],
    },
    "./node_modules/@droneey/devkit-ts-biome/plugins/empty-verbs.grit",
    "./node_modules/@droneey/devkit-ts-biome/plugins/body-cast.grit",
    "./node_modules/@droneey/devkit-ts-biome/plugins/type-names.grit",
  ],
}
