{
  "linter": {
    "rules": {
      "complexity": {
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 1,
          },
        },
      },
    },
  },
  "plugins": [
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/no-null.grit",
      "includes": [
        "**",
        "!**/adapters/**",
        "!**/models/**",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/surface.grit",
      "includes": [
        "**/index.ts",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/empty-names.grit",
      "includes": [
        "**",
        "!**/src/libs/**",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/case-names.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./node_modules/@droneey/devkit-ts-biome/plugins/module-mocks.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
