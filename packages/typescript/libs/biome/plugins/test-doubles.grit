language js

or {
  `mock.module($_, $_)` as $call where {
    register_diagnostic(span=$call, message="Fake an effect through its port, not by replacing a module", severity="error")
  },
  `$_.toEqual($_)` as $call where {
    register_diagnostic(span=$call, message="Compare with toStrictEqual: toEqual ignores undefined fields and class types", severity="error")
  }
}
