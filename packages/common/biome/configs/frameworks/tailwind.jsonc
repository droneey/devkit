{
  "linter": {
    "rules": {
      "nursery": {
        "noTailwindArbitraryValue": {
          "level": "error",
          "options": {
            "functions": [
              "cva",
              "cn",
              "clsx",
              "twMerge",
            ],
          },
        },
      },
    },
  },
  "plugins": [
    "./.devkit/biome/plugins/tailwind-classes.grit",
  ],
}
