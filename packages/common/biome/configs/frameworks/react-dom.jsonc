{
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAttribute": "error",
      },
      "correctness": {
        "useUniqueElementIds": "error",
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error",
      },
      "a11y": {
        "useValidAutocomplete": "error",
      },
    },
  },
  "plugins": [
    "./.devkit/common/biome/plugins/element-ids.grit",
    "./.devkit/common/biome/plugins/autocomplete.grit",
    {
      "path": "./.devkit/common/biome/plugins/test-queries.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
