{
  "overrides": [
    {
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "useConsistentMemberAccessibility": "off",
            "noExcessiveLinesPerFile": "off",
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
          },
          "complexity": {
            "noStaticOnlyClass": "off",
            "noExcessiveLinesPerFunction": "off",
          },
          "nursery": {
            "useExplicitType": "off",
            "noIdenticalTestTitle": "error",
          },
        },
      },
    },
  ],
  "plugins": [
    {
      "path": "./.devkit/common/biome/plugins/todo-tests.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
    {
      "path": "./.devkit/common/biome/plugins/strict-equal.grit",
      "includes": [
        "**/__tests__/**",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.test.ts",
        "**/*.test.tsx",
      ],
    },
  ],
}
