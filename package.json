{
  "name": "@droneey/devkit",
  "version": "1.22.1",
  "private": true,
  "description": "Shared development toolkit for consistent tooling across projects.",
  "homepage": "https://github.com/droneey/devkit#readme",
  "bugs": {
    "url": "https://github.com/droneey/devkit/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dmytro Kurovskyi",
    "url": "https://kurovskyi.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/droneey/devkit.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "bun run --cwd packages/typescript/libs/biome build",
    "clean": "rm -rf node_modules packages/typescript/libs/*/node_modules bun.lock",
    "test:unit": "bun test",
    "lint:check": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "packages:check": "syncpack lint && syncpack format --check",
    "packages:fix": "syncpack fix && syncpack format",
    "type:check": "tsc --noEmit",
    "architecture:check": "depcruise . --config .dependency-cruiser.mjs",
    "secrets:check": "betterleaks git . --redact --no-banner && betterleaks git . --pre-commit --redact --no-banner && betterleaks git . --pre-commit --staged --redact --no-banner",
    "check": "bun run lint:check && bun run packages:check && bun run type:check && bun run test:unit && bun run architecture:check && bun run secrets:check"
  },
  "workspaces": [
    "packages/typescript/libs/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@droneey/devkit-ts-biome": "workspace:*",
    "@droneey/devkit-ts-syncpack": "workspace:*",
    "@droneey/devkit-ts-tsconfig": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2"
  }
}
